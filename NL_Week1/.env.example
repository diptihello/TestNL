# Copy this file to .env and fill in your own values. Never commit .env.
# Every variable is optional except GROQ_API_KEY, which is needed only for AI explanations.
# An operating system environment variable overrides the same name in .env.
# Blank values fall back to the default shown here.

# --- Groq provider -----------------------------------------------------------
# Secret. Leave blank to run without AI (the app shows a rating-sorted list).
GROQ_API_KEY=
# Model id for ranking and explanations.
GROQ_MODEL=openai/gpt-oss-120b
# Seconds before a Groq call is abandoned.
LLM_TIMEOUT_SECONDS=30
# max_tokens for a ranking call. Reasoning tokens may count against it.
LLM_MAX_OUTPUT_TOKENS=900

# --- Candidate selection and results -----------------------------------------
# Restaurants sent to the model per search. Values above 20 are capped at 20.
MAX_CANDIDATES=12
# Cards shown per search. Must not exceed MAX_CANDIDATES.
MAX_RECOMMENDATIONS=5
# Vote weight m in the candidate score (higher trusts ratings with few votes less).
VOTE_WEIGHT=50
# Most candidates allowed with the same restaurant name.
MAX_PER_CHAIN=2
# Minimum seconds between searches in one session. 0 turns the gap off.
MIN_SUBMIT_INTERVAL_SECONDS=3

# --- Budget tiers (approximate cost for two people, INR) ---------------------
# low: cost <= BUDGET_LOW_MAX; medium: up to BUDGET_MEDIUM_MAX; high: above that.
# Defaults are the 33rd/66th cost percentiles of the ingested dataset (see manifest.json).
BUDGET_LOW_MAX=300
BUDGET_MEDIUM_MAX=500

# --- Groq limits recorded for the project ------------------------------------
RPM_LIMIT=30
RPD_LIMIT=1000
TPM_LIMIT=8000
TPD_LIMIT=200000

# --- Dataset -----------------------------------------------------------------
DATASET_REPO=ManikaSaini/zomato-restaurant-recommendation
# Pin a commit hash for reproducible ingestion.
DATASET_REVISION=main
# Output of scripts/ingest.py. A relative path is resolved against the project root.
PROCESSED_PATH=data/processed/restaurants.parquet

# --- Behaviour ---------------------------------------------------------------
# true, false, yes, no, on, off, 1 or 0. When true no API call is ever made.
DEMO_MODE=false
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
